# Copier ce fichier en .env pour le développement local (ne jamais le publier).
# Sur Vercel, ces variables se règlent dans Settings → Environment Variables.

# Mot de passe de l'espace organisateur (/admin). Choisissez-le long et unique.
ADMIN_PASSWORD=

# Base PostgreSQL (Neon). Ajoutée automatiquement par l'intégration Neon de Vercel.
# En local, laissez vide : une base embarquée est créée dans .data/
DATABASE_URL=

# Facultatif : secret de signature des sessions (sinon dérivé de ADMIN_PASSWORD).
SESSION_SECRET=
